{
  "name": "@universal-cms/platform",
  "version": "2.0.0-saas",
  "description": "Universal SaaS CMS Platform - No-Code Builder, Multi-Tenant, AI-Powered",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:admin\" \"npm run dev:worker\"",
    "dev:api": "nodemon server.js",
    "dev:admin": "vite dev admin",
    "dev:worker": "nodemon workers/queue-worker.js",
    "build": "npm run build:admin && npm run build:themes",
    "build:admin": "vite build admin",
    "build:themes": "node scripts/build-themes.js",
    "test": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "init": "node scripts/init-saas.js",
    "migrate": "node scripts/migrate-db.js",
    "seed": "node scripts/seed-data.js"
  },
  "keywords": [
    "cms",
    "saas",
    "no-code",
    "builder",
    "ecommerce",
    "multi-tenant",
    "headless",
    "ai-powered",
    "universal",
    "platform"
  ],
  "author": "Universal CMS Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "mongoose": "^8.0.0",
    "redis": "^4.6.11",
    "ioredis": "^5.3.2",
    "bullmq": "^4.15.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.4",
    "stripe": "^14.9.0",
    "openai": "^4.20.1",
    "sharp": "^0.33.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "slugify": "^1.6.6",
    "graphql": "^16.8.1",
    "apollo-server-express": "^3.13.0",
    "nodemailer": "^6.9.7",
    "handlebars": "^4.7.8",
    "axios": "^1.6.2",
    "dayjs": "^1.11.10",
    "sanitize-html": "^2.11.0",
    "nanoid": "^5.0.4",
    "cookie-parser": "^1.4.6",
    "morgan": "^1.10.0",
    "response-time": "^2.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "eslint": "^8.55.0",
    "vite": "^5.0.4",
    "vue": "^3.3.11",
    "@vitejs/plugin-vue": "^4.5.2",
    "element-plus": "^2.4.4",
    "playwright": "^1.40.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/universal-cms/platform.git"
  },
  "bugs": {
    "url": "https://github.com/universal-cms/platform/issues"
  },
  "homepage": "https://universal-cms.io",
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
