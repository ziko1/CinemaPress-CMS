# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/universal_cms

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Stripe Billing (Production Keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Test Keys (Development)
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...

# Pricing Plan IDs (Stripe)
STRIPE_PRICE_ID_FREE=price_free_tier
STRIPE_PRICE_ID_PRO=price_pro_tier_monthly
STRIPE_PRICE_ID_BUSINESS=price_business_tier_monthly
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_tier

# OpenAI API
OPENAI_API_KEY=sk-...
OPENAI_ORGANIZATION=org-...
OPENAI_MAX_TOKENS=4096

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=universal-cms-storage
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=  # Optional for S3-compatible services (Minio, DigitalOcean Spaces)

# Email Configuration (SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@universal-cms.io

# Alternative: SendGrid
SENDGRID_API_KEY=SG....

# Application Settings
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
API_URL=http://localhost:3000/api
NODE_ENV=development
PORT=3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# CDN Configuration (Optional)
CDN_URL=https://cdn.universal-cms.io
CDN_ENABLED=false

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=plausible  # plausible, google, fathom

# Error Tracking
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
FEATURE_AI_ENABLED=true
FEATURE_MARKETPLACE_ENABLED=false
FEATURE_CUSTOM_DOMAINS_ENABLED=true
FEATURE_WHITE_LABEL_ENABLED=false

# Multi-Tenancy
TENANT_ISOLATION_LEVEL=logicial  # logical or database
DEFAULT_TENANT_PLAN=free

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=universal-cms-backups

# Queue Configuration
QUEUE_CONCURRENCY=5
QUEUE_DEFAULT_JOB_TIMEOUT=300000

# Session Configuration
SESSION_SECRET=your-session-secret-key
SESSION_COOKIE_NAME=universal_cms_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAME_SITE=lax

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# reCAPTCHA (For Forms)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# AI Translation Service (Alternative to OpenAI)
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Performance
CACHE_TTL=3600
COMPRESSION_ENABLED=true
RESPONSE_TIME_HEADER=true

# Security
CORS_ORIGIN=*
HELMET_ENABLED=true
CSRF_PROTECTION_ENABLED=false

# Development Only
DEBUG_MODE=true
MOCK_STRIPE=false
MOCK_AI=false
